st.sidebar.title("Filters")

search = st.sidebar.text_input("🔎 Search stories")

if search:
    filtered_articles = [
        article for article in articles
        if search.lower() in article["title"].lower()
        or search.lower() in article["source"].lower()
    ]
else:
    filtered_articles = articles

st.write(f"### {len(filtered_articles)} stories found")


for article in filtered_articles:

    st.subheader(article["title"])

    st.caption(f"📰 {article['source']}")

    st.markdown(
        f"🔗 [Read the full article]({article['link']})"
    )

    st.divider()
